# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage output
.coverage
.coverage.*
htmlcov/
coverage.xml

# Packaging output
build/
dist/
*.egg-info/

# Keep our hand-written PyInstaller spec in Git.
# Do NOT add *.spec here: Kaokey.spec will be part of the project.

# IDE / editor files
.vscode/
.idea/
*.code-workspace

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs / temporary files
*.log
*.tmp
*.temp
~$*

# Local scratch / backups
scratch/
tmp/
*.bak
